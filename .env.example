# Local service configuration
POSTGRES_DB=lead_intake
POSTGRES_USER=lead_intake
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://lead_intake:change-me-for-local-development@postgres:5432/lead_intake

# Browser configuration. Use the production n8n webhook URL after activating it.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-intake
N8N_BOOKING_WEBHOOK_URL=http://localhost:5678/webhook/appointment-booking
N8N_REQUEST_TIMEOUT_MS=30000

# Lifecycle demonstration settings. The intentionally short delay keeps the local demo repeatable.
FOLLOW_UP_DELAY_SECONDS=120
BUSINESS_TIMEZONE=America/Vancouver

# Shared only between n8n and the local development CRM adapter. Generate locally;
# never place this value in the frontend, source control, or screenshots.
CRM_ADAPTER_API_KEY=replace-with-a-long-random-local-secret

# CRM provider selection. The default preserves the existing local development provider.
# For the contract demo, use highlevel_simulator and generate a separate local-only token.
# highlevel_live intentionally fails closed until real account verification is approved.
CRM_PROVIDER_MODE=development
HIGHLEVEL_SIMULATOR_TOKEN=replace-with-a-separate-long-random-local-token
HIGHLEVEL_BASE_URL=http://highlevel-simulator:8080
HIGHLEVEL_TIMEOUT_SECONDS=2

# Local simulator mappings. These are deliberately simulator-prefixed and are not vendor IDs.
HIGHLEVEL_LOCATION_ID=sim_location_reference
HIGHLEVEL_PIPELINE_ID=sim_pipeline_hvac
HIGHLEVEL_STAGE_NEW_LEAD_ID=sim_stage_new_lead
HIGHLEVEL_STAGE_CONTACTED_ID=sim_stage_contacted
HIGHLEVEL_STAGE_APPOINTMENT_BOOKED_ID=sim_stage_appointment_booked
HIGHLEVEL_CONTACT_SUBMISSION_FIELD_ID=sim_cf_submission_id
HIGHLEVEL_CONTACT_CORRELATION_FIELD_ID=sim_cf_correlation_id
HIGHLEVEL_OPPORTUNITY_SUBMISSION_FIELD_ID=sim_of_submission_id

# n8n runtime budgets (milliseconds). Configure these in the n8n container, not here.
NVIDIA_NIM_TIMEOUT_MS=18000
CRM_ADAPTER_TIMEOUT_MS=6000
CRM_CONTROL_TIMEOUT_MS=3000

# Required only by the separate manual n8n management-reporting workflow.
# Treat the Make Custom Webhook URL as a capability secret and configure the real value only
# in protected local n8n runtime configuration.
MAKE_REPORTING_WEBHOOK_URL=
MAKE_REPORTING_TIMEOUT_MS=10000

# Required only by the n8n instance; never commit the actual value.
NVIDIA_NIM_API_KEY=replace-with-nvidia-api-key
NVIDIA_NIM_MODEL=replace-with-an-enabled-nvidia-model-id
