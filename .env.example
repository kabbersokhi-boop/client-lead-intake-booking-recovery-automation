# Local service configuration
POSTGRES_DB=lead_intake
POSTGRES_USER=lead_intake
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://lead_intake:change-me-for-local-development@postgres:5432/lead_intake

# Browser configuration. Use the production n8n webhook URL after activating it.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-intake
N8N_REQUEST_TIMEOUT_MS=15000

# Shared only between n8n and the local development CRM adapter. Generate locally;
# never place this value in the frontend, source control, or screenshots.
CRM_ADAPTER_API_KEY=replace-with-a-long-random-local-secret

# n8n runtime budgets (milliseconds). Configure these in the n8n container, not here.
NVIDIA_NIM_TIMEOUT_MS=10000
CRM_ADAPTER_TIMEOUT_MS=8000

# Required only by the n8n instance; never commit the actual value.
NVIDIA_NIM_API_KEY=replace-with-nvidia-api-key
NVIDIA_NIM_MODEL=replace-with-an-enabled-nvidia-model-id
