{
  "id": "phase2-follow-up-dispatch",
  "name": "Lifecycle - Dispatch Due Follow-ups",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 1 }
          ]
        }
      },
      "id": "schedule-follow-ups",
      "name": "Check Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 260]
    },
    {
      "parameters": {
        "url": "={{ $env.CRM_ADAPTER_URL + '/api/crm/follow-ups/due?limit=25' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-CRM-Adapter-Key", "value": "={{ $env.CRM_ADAPTER_API_KEY }}" }
          ]
        },
        "options": { "timeout": "={{ Number($env.CRM_ADAPTER_TIMEOUT_MS || 6000) }}" }
      },
      "id": "fetch-due-follow-ups",
      "name": "Fetch Due Pending Follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 260]
    },
    {
      "parameters": {
        "jsCode": "const received = $input.all().map((item) => item.json);\nconst records = received.length === 1 && Array.isArray(received[0]) ? received[0] : received;\nreturn records.filter((record) => record && record.status === 'pending' && typeof record.id === 'string').map((record) => ({ json: record }));"
      },
      "id": "select-due-follow-ups",
      "name": "Select Due Pending Follow-ups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_ADAPTER_URL + '/api/crm/follow-ups/' + $json.id + '/dispatch' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-CRM-Adapter-Key", "value": "={{ $env.CRM_ADAPTER_API_KEY }}" }
          ]
        },
        "options": { "timeout": "={{ Number($env.CRM_ADAPTER_TIMEOUT_MS || 6000) }}" }
      },
      "id": "dispatch-follow-up",
      "name": "Send Test Email and Mark Contacted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 260]
    }
  ],
  "pinData": {},
  "connections": {
    "Check Every Minute": { "main": [[{ "node": "Fetch Due Pending Follow-ups", "type": "main", "index": 0 }]] },
    "Fetch Due Pending Follow-ups": { "main": [[{ "node": "Select Due Pending Follow-ups", "type": "main", "index": 0 }]] },
    "Select Due Pending Follow-ups": { "main": [[{ "node": "Send Test Email and Mark Contacted", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
