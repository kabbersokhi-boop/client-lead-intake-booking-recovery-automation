#!/bin/sh
set -eu

project=hvac-guided-demo
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_dir="$root/.demo"
env_file="$runtime_dir/runtime.env"
compose_file="$root/compose.demo.yml"

generate_env() {
  if [ -f "$env_file" ]; then
    return
  fi
  mkdir -p "$runtime_dir"
  chmod 700 "$runtime_dir"
  umask 077
  {
    echo "DEMO_POSTGRES_PASSWORD=$(openssl rand -hex 24)"
    echo "DEMO_ADAPTER_KEY=$(openssl rand -hex 32)"
    echo "DEMO_SIMULATOR_TOKEN=$(openssl rand -hex 32)"
    echo "DEMO_CONTROL_KEY=$(openssl rand -hex 32)"
    echo "DEMO_AI_TOKEN=$(openssl rand -hex 32)"
    echo "DEMO_N8N_ENCRYPTION_KEY=$(openssl rand -hex 32)"
  } > "$env_file"
}

compose() {
  docker compose --project-name "$project" --env-file "$env_file" -f "$compose_file" "$@"
}

wait_ready() {
  attempt=0
  until curl --fail --silent --show-error http://127.0.0.1:28000/api/demo/readiness > "$runtime_dir/readiness.json" \
    && grep -q '^{"ready":true,' "$runtime_dir/readiness.json"
  do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 60 ]; then
      compose ps
      echo "Demo readiness timed out. Inspect with: ./scripts/demo logs" >&2
      exit 1
    fi
    sleep 2
  done
}

case "${1:-}" in
  up)
    generate_env
    compose up --detach --build
    wait_ready
    echo "Guided demo ready: http://localhost:28000/demo.html"
    echo "Simulator: http://localhost:28080  Mailpit: http://localhost:28025"
    ;;
  status)
    generate_env
    compose ps
    curl --fail --silent --show-error http://127.0.0.1:28000/api/demo/readiness
    echo
    ;;
  logs)
    generate_env
    if [ -n "${2:-}" ]; then
      compose logs --tail=200 "$2"
    else
      compose logs --tail=200
    fi
    ;;
  reset)
    generate_env
    compose down --volumes --remove-orphans
    echo "Removed only the '$project' containers, network, and named demo volumes."
    echo "Run './scripts/demo up' for a clean demonstration."
    ;;
  down)
    generate_env
    compose down --remove-orphans
    ;;
  *)
    echo "Usage: ./scripts/demo {up|status|logs [service]|down|reset}" >&2
    exit 2
    ;;
esac
